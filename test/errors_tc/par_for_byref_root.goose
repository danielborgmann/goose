// error: reaches out only through x
// R2: `&x` owns the elements, so the body reaches them only through x.
import std;

var counter = 0;
fn bump() { counter += 1; }
fn shout(x: i64) { print(x); }
fn make() -> i64[>..] { var r: i64[>..] = []; r.push(1); return r; }

fn main() {
    var out: i64[>..] = [];
    for i in 10 { out.push(0); }
    var total = 0;
    let n = 4;
    par for &x in out { x = out[0]; }
    print(out, total);
}
